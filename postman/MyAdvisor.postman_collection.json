    {
      "name": "3. Advisor Workflows",
      "description": "The advisor queue, review screen, approve/reject decisions, and authorization failures. Each advisor request uses `{{advisorToken}}`.",
      "item": [
        {
          "name": "List Pending Plans",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test(\"returns assigned submitted plans\", () => {",
                  "  pm.expect(rows).to.be.an(\"array\");",
                  "  const ids = rows.map(row => row.planID);",
                  "  pm.expect(ids).to.include(Number(pm.environment.get(\"planId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{advisorToken}}",
                  "type": "string"
                }
              ]
            },
