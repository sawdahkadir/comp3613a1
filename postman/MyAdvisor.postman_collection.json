{
  "info": {
    "_postman_id": "6f4c1a2e-9d3b-4e57-8a10-2b7c5d9e4f61",
    "name": "MyAdvisor API v1",
    "description": "Versioned JSON API for the MyAdvisor COMP3613 project.\n\nRun against a freshly seeded database:\n\n    python manage.py init\n    python manage.py run\n\nThen select the **MyAdvisor Local** environment and run the whole collection with the Collection Runner. Requests are ordered so tokens, plan IDs and course IDs are chained through environment variables.\n\nSeeded logins: bob / bobpass (student), admin / adminpass (advisor).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Auth",
      "description": "Log in as the student and the advisor, then prove the API rejects bad or missing credentials.",
      "item": [
        {
          "name": "Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns a bearer token\", () => {",
                  "  pm.expect(body.token_type).to.eql(\"bearer\");",
                  "  pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.username).to.eql(\"bob\");",
                  "  pm.expect(body.role).to.eql(\"regular_user\");",
                  "});",
                  "pm.environment.set(\"accessToken\", body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{studentUsername}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "JSON login. Saves the returned Bearer token to `accessToken`."
          }
        },
        {
          "name": "Advisor Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns an admin token\", () => {",
                  "  pm.expect(body.access_token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.role).to.eql(\"admin\");",
                  "});",
                  "pm.environment.set(\"advisorToken\", body.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{advisorUsername}}\",\n  \"password\": \"{{advisorPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Logs in the advisor account. Saves the token to `advisorToken`."
          }
        },
        {
          "name": "Invalid Login (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"explains the failure\", () => {",
                  "  pm.expect(pm.response.json().detail).to.include(\"Incorrect username or password\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{studentUsername}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Failure case: a bad password must return 401 JSON, not an HTML page."
          }
        },
        {
          "name": "No Token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"returns a JSON error body\", () => {",
                  "  pm.expect(pm.response.json()).to.have.property(\"detail\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "plans"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Failure case: protected endpoint with no Authorization header."
          }
        }
      ]
    },
    {
      "name": "2. Student Workflows",
      "description": "Degree progress, course catalogue, and the full semester-plan lifecycle (create, read, update, submit) including rule failures.",
      "item": [
        {
          "name": "Get Degree Progress",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns degree totals\", () => {",
                  "  pm.expect(body.creditsTotal).to.be.above(0);",
                  "  pm.expect(body.creditsCompleted).to.be.at.least(0);",
                  "  pm.expect(body.percentComplete).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"lists completed courses\", () => {",
                  "  pm.expect(body.completedCourses).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/me/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "me",
                "progress"
              ]
            },
            "description": "Workflow 1: view degree progress as the signed-in student."
          }
        },
        {
          "name": "Get Course Catalogue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const courses = pm.response.json();",
                  "pm.test(\"returns the seeded catalogue\", () => {",
                  "  pm.expect(courses).to.be.an(\"array\").with.length.above(0);",
                  "});",
                  "const byCode = {};",
                  "courses.forEach(course => { byCode[course.code] = course.courseID; });",
                  "pm.test(\"seeded course codes are present\", () => {",
                  "  pm.expect(byCode).to.have.property(\"COMP6039\");",
                  "  pm.expect(byCode).to.have.property(\"COMP6048\");",
                  "  pm.expect(byCode).to.have.property(\"COMP6045\");",
                  "});",
                  "pm.environment.set(\"courseId\", byCode.COMP6039);",
                  "pm.environment.set(\"courseIdB\", byCode.COMP6048);",
                  "pm.environment.set(\"blockedCourseId\", byCode.COMP6045);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ]
            },
            "description": "Returns every course with an `alreadyCompleted` flag. Saves real IDs for the plan requests:\n- `courseId` = COMP6039\n- `courseIdB` = COMP6048\n- `blockedCourseId` = COMP6045 (prerequisite COMP6037 not completed)."
          }
        },
